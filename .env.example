# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://sua-url-supabase.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima
# Usada SOMENTE no servidor (Server Actions). Nunca use o prefixo NEXT_PUBLIC_.
# Sem ela, o servidor usa a chave anônima e o RLS do banco bloqueia as escritas
# (o app então cai nos dados de demonstração em memória).
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# --- Sessões ----------------------------------------------------------------
# Segredo para assinar os cookies de sessão (mínimo 32 caracteres).
# OBRIGATÓRIO em produção. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- Credenciais de acesso ----------------------------------------------------
# Enquanto vazias e FORA de produção, o sistema roda em "modo demonstração"
# (qualquer senha/PIN entra). Em produção, sem elas, o login é recusado.
ADMIN_EMAIL=admin@dermabichos.com.br
ADMIN_PASSWORD=
STAFF_PIN=

# --- Modo demonstração (FASE DE TESTES) ----------------------------------------
# Hoje o modo demonstração fica LIGADO por padrão, inclusive na Vercel: qualquer
# login entra enquanto ADMIN_PASSWORD / STAFF_PIN estiverem vazios.
# Na produção REAL (dados de clientes), defina DEMO_MODE=false e configure
# SESSION_SECRET, ADMIN_PASSWORD e STAFF_PIN.
DEMO_MODE=
